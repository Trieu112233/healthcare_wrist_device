    {
        "id": "1de07567d7c8501a",
        "type": "function",
        "z": "570c44e401933bf0",
        "name": "Lọc & định dạng dữ liệu alert",
        "func": "var incomingData = msg.payload;\n\nif (incomingData.fall_confidence >= 0.7 || incomingData.scream_confidence >= 0.7) {\n    \n    var alertType = \"UNKNOWN\";\n    if (incomingData.fall_confidence >= 0.7 && incomingData.scream_confidence >= 0.7) {\n        alertType = \"NGA_VA_HET\";\n    } else if (incomingData.fall_confidence >= 0.7) {\n        alertType = \"PHAT_HIEN_NGA\";\n    } else {\n        alertType = \"TIENG_HET_LON\";\n    }\n\n    // Phải để operation, collection, document\n    // vào bên trong object `msg.firestore`\n    var targetDevice = incomingData.deviceId;\n    \n    msg.firestore = {\n        operation: \"update\",          // Chỉ định rõ hành động mong muốn\n        collection: \"devices\",        // Tên bảng\n        document: targetDevice        // Tên TÀI LIỆU CẦN SỬA\n    };\n\n    // Dữ liệu payload: Những trường bạn cần Firebase cập nhật\n    msg.payload = {\n        alert: true,\n        alert_type: alertType,\n        last_alert_time: \"_serverTimestamp\" // Cực hay! Theo tài liệu, nó sẽ tự lấp đầy giờ server thực tế\n    };\n    \n    return msg; \n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
