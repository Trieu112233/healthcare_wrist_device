    {
        "id": "1de07567d7c8501a",
        "type": "function",
        "z": "570c44e401933bf0",
        "name": "Lọc & định dạng dữ liệu alert",
        "func": "var incomingData = msg.payload;\n\nvar threshold = 0.8;\nvar screamCooldownMs = 30000;\n\nif (!incomingData || !incomingData.deviceId) {\n    return null;\n}\n\nvar fallConfidence = Number(incomingData.fall_confidence || 0);\nvar screamConfidence = Number(incomingData.scream_confidence || 0);\n\nif (fallConfidence < threshold && screamConfidence < threshold) {\n    return null;\n}\n\nvar alertType = \"UNKNOWN\";\nif (fallConfidence >= threshold && screamConfidence >= threshold) {\n    alertType = \"NGA_VA_HET\";\n} else if (fallConfidence >= threshold) {\n    alertType = \"PHAT_HIEN_NGA\";\n} else {\n    alertType = \"PHAT_HIEN_TIENG_HET\";\n}\n\nvar targetDevice = incomingData.deviceId;\n\nif (alertType === \"PHAT_HIEN_TIENG_HET\") {\n    var cooldownKey = targetDevice + \":\" + alertType;\n    var now = Date.now();\n    var lastScreamAlertMap = flow.get(\"lastScreamAlertMap\") || {};\n    var lastAlertAt = lastScreamAlertMap[cooldownKey] || 0;\n\n    if (now - lastAlertAt < screamCooldownMs) {\n        node.status({\n            fill: \"yellow\",\n            shape: \"ring\",\n            text: \"cooldown \" + alertType\n        });\n        return null;\n    }\n\n    lastScreamAlertMap[cooldownKey] = now;\n    flow.set(\"lastScreamAlertMap\", lastScreamAlertMap);\n}\n\nmsg.firestore = {\n    operation: \"update\",\n    collection: \"devices\",\n    document: targetDevice\n};\n\nmsg.payload = {\n    alert: true,\n    alert_type: alertType,\n    last_alert_time: \"_serverTimestamp\"\n};\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"sent \" + alertType\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
